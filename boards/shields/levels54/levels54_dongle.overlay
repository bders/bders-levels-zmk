// boards/shields/levels54/levels54_dongle.overlay

// Pull in the shared keyboard definitions for trackball splits & listeners
#include "../../arm/levels54/levels54.dts"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows  = <0>;
        events = <0>;
    };

    default: keymap_transform0 {
        // ... your matrix-transform here ...
    };
};

/* Enable both trackball listeners defined in levels54.dts */
&trackball_peripheral_listener {
    status = "okay";
};

&trackball_central_listener {
    status = "okay";
};