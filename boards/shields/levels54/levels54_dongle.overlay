// Dongle overlay for Levels54 using a Prospector-based central. It provides
// a mock kscan (no keys), copies the matrix transform, and defines pointing
// listeners for both halves.

#include <dt-bindings/zmk/matrix_transform.h>

 / {
    /* Use a mock scanner—no physical keys on the dongle. */
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows    = <0>;
        events  = <0>;
    };

    /* Matrix transform copied from boards/arm/levels54/levels54.dts. */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows    = <5>;
        map = <
            /* row0 */ RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)      RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            /* row1 */ RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)      RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            /* row2 */ RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)      RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            /* row3 */ RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)      RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            /* row4 */                      RC(4,3) RC(4,4) RC(4,5)      RC(4,6) RC(4,7) RC(4,8)
        >;
    };

    {
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        };
    };

    /* Define pointing listeners for both halves. These are local to this
     * overlay and do not reference the board DTS, so they compile on any MCU.
     */
    trackball_peripheral_listener: trackball_listener_split {
        compatible = "zmk,pointing-device-split-listener";
        status = "okay";
    };

    trackball_central_listener: trackball_listener_split2 {
        compatible = "zmk,pointing-device-split-listener";
        status = "okay";
    };
 };