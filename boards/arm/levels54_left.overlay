
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    mouse_layer {
        layers = <1>;
        input-processors = <&zip_ble_report_rate_limit>;
    };
};

&trackball_peripheral_split_listener {
    status = "okay";
    device = <&trackball_peripheral>;  /* if your split device is &trackball_peripheral_split, use that */
    /delete-property/ input-processors;

    mouse_layer {
        layers = <1>;
        input-processors = <&zip_ble_report_rate_limit>;
    };
};
